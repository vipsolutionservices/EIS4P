# vogo-mcp memory service — copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=3000

# API key that protects every /api/v1 route (X-API-Key header).
API_KEY=change_me_64_hex

# MariaDB/MySQL (on vogo.me these are the WordPress DB credentials).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_TABLE_PREFIX=mcp_
DB_POOL=5

# CORS + rate (optional)
CORS_ORIGINS=*

# MCP server -> REST API wiring (used by src/mcp/server.js)
MCP_API_BASE_URL=http://127.0.0.1:3000/api/v1
MCP_API_KEY=change_me_64_hex
